import React from 'react';
import './SongCard.css';
import { toast } from 'react-hot-toast';
import { FaPlay, FaPlus } from "react-icons/fa";
import axios from "../services/axiosInstance";

const SongCard = ({ song }) => {
    const playTrack = async () => {
        try {
            await axios.post("/spotify/play", null, {
                params: { uri: song.uri },
            });
            toast.success("▶️ Playing song");
        } catch (error) {
            console.error("Error al reproducir", error);
            toast.error("Error al reproducir");
        }
    };

    const addToQueue = async () => {
        try {
            await axios.post("/spotify/queue", null, {
                params: { uri: song.uri },
            });
            toast.success("➕ Added to queue");
        } catch (error) {
            console.error("Error adding to queue", error);
            toast.error("Error adding to queue");
        }
    };

    return (
        <div className="song-card">
            <div className="song-card__image-container">
                <img
                    src={song.imageUrl}
                    alt={song.title}
                    className="song-card__image"
                    onError={(e) => {
                        e.target.src = "https://via.placeholder.com/300x300?text=No+Image";
                    }}
                />
                <div className="song-card__actions">
                    <button onClick={playTrack} className="song-card__icon-button">
                        <FaPlay />
                    </button>
                    <button onClick={addToQueue} className="song-card__icon-button">
                        <FaPlus />
                    </button>
                </div>
            </div>
            <div className="song-card__info">
                <h3 className="song-card__title">{song.title.length > 35 ? `${song.title.slice(0, 35)}...` : song.title}</h3>
                <p className="song-card__artist">{song.artist}</p>
            </div>
        </div>
    );
};

export default SongCard;
